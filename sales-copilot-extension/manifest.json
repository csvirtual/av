{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Co-piloto de vendas com IA - C&S Virtual",
  "version": "2.49.5",
  "description": "Seu braço direito nas vendas consultivas pelo WhatsApp.",
  "action": {
    "default_title": "Abrir o Co-piloto de vendas"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "shared/logger.js",
        "shared/messaging.js",
        "core/conversation-normalizer.js",
        "content/selectors.js",
        "content/whatsapp-adapter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
