{
  "manifest_version": 3,
  "name": "Co-piloto de vendas com IA - C&S Virtual",
  "version": "2.47.3",
  "description": "Co-piloto de vendas por WhatsApp com apoio de IA.",
  "action": {
    "default_title": "Abrir o Co-piloto de vendas"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
