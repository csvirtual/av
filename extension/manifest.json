{
  "manifest_version": 3,
  "name": "Gestão de Loja — Estoque & Vendas",
  "version": "1.0.0",
  "description": "Controle de estoque, vendas e usuários para loja de material de construção + mercearia. Funciona 100% local, sem servidor.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir Gestão de Loja"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "minimum_chrome_version": "102"
}
